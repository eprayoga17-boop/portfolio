# Copy to .env.local for local dev. On Vercel, add these under Project Settings > Environment Variables.
# Without the Supabase values the site still runs, using the bundled seed content (admin shows a setup notice).

# Public (shipped to the browser, safe to expose)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random chars each. Generate with: openssl rand -hex 32
IP_HASH_SECRET=
CRON_SECRET=
# Days to keep contact-form messages before automatic deletion (UU PDP storage limitation)
INQUIRY_RETENTION_DAYS=365
